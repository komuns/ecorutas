# Copia este archivo como ".env" y ajusta los valores:  cp .env.example .env
SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos: sqlite3 (por defecto) | postgresql | mysql
DB_ENGINE=sqlite3
DB_NAME=db.sqlite3
# Solo si usas postgresql o mysql (requiere instalar psycopg / mysqlclient):
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=
